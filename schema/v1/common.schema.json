{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common definitions",
  "description": "Shared primitive types reused across the VRoom scene schema.",
  "$defs": {
    "Vector2": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "Vector3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "Quaternion": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number" }
      },
      "required": ["x", "y", "z", "w"],
      "additionalProperties": false
    },
    "Polygon2D": {
      "description": "Ordered boundary points of a planar surface, in the object's local space.",
      "type": "array",
      "items": { "$ref": "#/$defs/Vector2" },
      "minItems": 3
    },
    "Bounds3D": {
      "description": "Axis-aligned local-space bounding box, used for volumetric (non-planar) objects.",
      "type": "object",
      "properties": {
        "min": { "$ref": "#/$defs/Vector3" },
        "max": { "$ref": "#/$defs/Vector3" }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
